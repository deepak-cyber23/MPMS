# MongoDB Connection URI (Local MongoDB Community Server or MongoDB Atlas cloud cluster)
# For Netlify deployment, set this in Netlify Site Settings > Environment Variables:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mpms_db?retryWrites=true&w=majority

# JWT Secret Key for Admin & User Authentication
JWT_SECRET=mpms_enterprise_jwt_secret_key_2026

# Express Backend Server Port (local dev / external backend)
PORT=5000

# Frontend API Base URL:
# - Leave default '/api' when using Netlify Functions (proxied via netlify.toml / _redirects)
# - Set to your deployed backend URL (e.g. 'https://my-backend.onrender.com/api') if running backend externally
VITE_API_URL=/api
